{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "bundle": {
    "targets": ["nsis"],
    "publisher": "mqtt-panel.com",
    "homepage": "https://mqtt-panel.com",
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
