      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5M0JBREI3QjY0QjFBN0IKUldSN0drdTJ0NjA3T1YrakRjMWJ6OWdVdk1DbUMvbU1pdE1pSU1IS29QZFpHRHo4TVE4ejhwbVMK",
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
