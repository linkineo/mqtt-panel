{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MQTT Panel",
  "mainBinaryName": "MQTT Panel",
  "version": "0.1.0",
  "identifier": "com.remora-labs.mqttpanel",
  "build": {
    "beforeDevCommand": "npm run dev -w @mqttpanel/ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build -w @mqttpanel/ui",
    "frontendDist": "../../../packages/ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MQTT Panel",
        "width": 1280,
        "height": 760,
        "minWidth": 1024,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "copyright": "mqtt-panel.com",
    "shortDescription": "MQTT client, embedded broker and command line",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
