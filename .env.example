# Copy to .env.local (git-ignored) and fill in. Used by scripts/release-mac-testflight.sh and scripts/release-mac-dmg.sh. No secrets here:
# the App Store Connect key stays in ~/.appstoreconnect/private_keys, the signing keys in the login keychain.
ASC_KEY_ID=
ASC_ISSUER_ID=
APPLE_TEAM_ID=
# Exact identity names as shown by: security find-identity -v
APPLE_SIGNING_IDENTITY="Apple Distribution: <holder> (<team>)"
APPLE_INSTALLER_IDENTITY="3rd Party Mac Developer Installer: <holder> (<team>)"
# Mac App Store provisioning profile downloaded from App Store Connect
MQTTPANEL_PROVISIONING_PROFILE=~/.appstoreconnect/MQTTPanel_MacAppStore.provisionprofile
# Developer ID identity for the direct-download DMG (scripts/release-mac-dmg.sh); created by the account holder
APPLE_DEVELOPER_ID_IDENTITY="Developer ID Application: <holder> (<team>)"
# Optional: path of the App Store Connect key when it is not ~/.appstoreconnect/private_keys/AuthKey_<key id>.p8
# ASC_KEY_PATH=
# Updater signing key of the DMG (docs/UPDATER.md), generated once with
#   cargo tauri signer generate -w ~/.tauri/mqttpanel-updater.key
# The key file stays in the owner's home folder and backups; its password goes into .env.local only, never here.
TAURI_SIGNING_PRIVATE_KEY_PATH=~/.tauri/mqttpanel-updater.key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
